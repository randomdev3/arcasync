{
	"$schema": "./node_modules/wrangler/config-schema.json",
	// The top level is production-safe: a bare `wrangler deploy` ships with dev login and debug
	// stats off and no secret, so every route answers 503 until `wrangler secret put
	// ARCASYNC_SECRET` (src/config.ts). Environments do not inherit vars or durable_objects,
	// so every env repeats them (test/config.test.ts checks the resolved result).
	"name": "arcasync-relay",
	"main": "src/worker.ts",
	"compatibility_date": "2026-11-01",
	"durable_objects": {
		"bindings": [
			{ "name": "ACCOUNTS", "class_name": "AccountsDO" },
			{ "name": "RELAY", "class_name": "WorkspaceRelay" }
		]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["AccountsDO", "WorkspaceRelay"] }],
	// The website (packages/site, built by turbo before this package). Static files are served by
	// the asset layer and never invoke the Worker (free, unlimited); unknown paths get 404.html from
	// the asset layer too. Only `/api/*` and `/ws` run the Worker. No binding: the Worker never
	// reads assets. Inherited by every env (test/config.test.ts checks it).
	"assets": {
		"directory": "../site/dist",
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "404-page",
		"run_worker_first": ["/api/*", "/ws"]
	},
	// Environments do not inherit bindings either: production and dev repeat this, probe has none
	// (no R2 in the probe, so its `features.chunks` stays false). Dev uses wrangler's local R2
	// emulation; the production bucket is created by the user.
	"r2_buckets": [{ "binding": "CHUNKS", "bucket_name": "arcasync-chunks" }],
	"vars": {
		"ARCASYNC_DEV_OPEN_LOGIN": "0",
		"ARCASYNC_DEBUG_STATS": "0",
		"ARCASYNC_MAX_FILE_BYTES": "209715200"
	},
	// `dev` settings are top-level only; this is the port for `wrangler dev --env dev`. The Node
	// server defaults to 8787, so `pnpm dev` (turbo runs both) stays collision-free.
	"dev": { "port": 8789 },
	"observability": { "enabled": false },
	"env": {
		// `pnpm -F @arcasync/relay-cf deploy:production` (user only).
		"production": {
			"name": "arcasync-relay",
			"durable_objects": {
				"bindings": [
					{ "name": "ACCOUNTS", "class_name": "AccountsDO" },
					{ "name": "RELAY", "class_name": "WorkspaceRelay" }
				]
			},
			"r2_buckets": [{ "binding": "CHUNKS", "bucket_name": "arcasync-chunks" }],
			"vars": {
				"ARCASYNC_DEV_OPEN_LOGIN": "0",
				"ARCASYNC_DEBUG_STATS": "0",
				"ARCASYNC_MAX_FILE_BYTES": "209715200"
			},
			"observability": { "enabled": true }
		},
		// Local `wrangler dev --env dev` (pnpm dev, scripts/dev-server.mjs, tests). Never deployed.
		"dev": {
			"durable_objects": {
				"bindings": [
					{ "name": "ACCOUNTS", "class_name": "AccountsDO" },
					{ "name": "RELAY", "class_name": "WorkspaceRelay" }
				]
			},
			"r2_buckets": [{ "binding": "CHUNKS", "bucket_name": "arcasync-chunks" }],
			"vars": {
				"ARCASYNC_SECRET": "arcasync-local-dev-secret-not-for-production",
				"ARCASYNC_ALLOW_DEV_SECRET": "1",
				// Public, dev only: the bearer for `POST /api/auth/bootstrap` in local tests and e2e.
				"ARCASYNC_BOOTSTRAP_TOKEN": "arcasync-local-dev-bootstrap-token-not-secret-0",
				"ARCASYNC_DEV_OPEN_LOGIN": "1",
				"ARCASYNC_DEBUG_STATS": "1",
				"ARCASYNC_MAX_FILE_BYTES": "209715200",
				// Base of invite and device-code links (`/join?invite=`, `/approve?code=`). Unset in
				// production and probe until the public host is decided: the request origin is used.
				// scripts/dev-server.mjs overrides it with the port it starts on.
				"ARCASYNC_PUBLIC_URL": "http://localhost:8789"
			}
		},
		// Throwaway free-tier probe (R-9): open dev login and debug stats, secret via `wrangler
		// secret put ARCASYNC_SECRET --env probe`. Delete it after the probe.
		"probe": {
			"name": "arcasync-relay-probe",
			"durable_objects": {
				"bindings": [
					{ "name": "ACCOUNTS", "class_name": "AccountsDO" },
					{ "name": "RELAY", "class_name": "WorkspaceRelay" }
				]
			},
			"vars": {
				"ARCASYNC_DEV_OPEN_LOGIN": "1",
				"ARCASYNC_DEBUG_STATS": "1",
				"ARCASYNC_MAX_FILE_BYTES": "209715200"
			}
		}
	}
}
