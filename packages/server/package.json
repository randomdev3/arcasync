{
	"name": "@arcasync/server",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"main": "./dist/index.js",
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"build": "tsc -p tsconfig.build.json",
		"start": "node dist/index.js",
		"db:generate": "drizzle-kit generate",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "vitest run",
		"smoke": "tsx scripts/ws-smoke.ts"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.700.0",
		"@electric-sql/pglite": "0.5.8",
		"@hocuspocus/server": "4.7.0",
		"@hono/node-server": "^1.13.0",
		"@hono/zod-validator": "^0.7.0",
		"@arcasync/shared": "workspace:*",
		"drizzle-orm": "0.45.2",
		"hono": "^4.6.0",
		"jose": "^6.0.0",
		"pg": "^8.13.0",
		"pino": "^9.5.0",
		"prom-client": "^15.1.0",
		"ws": "^8.18.0",
		"yjs": "13.6.32",
		"zod": "^4.1.0"
	},
	"devDependencies": {
		"@hocuspocus/provider": "4.7.0",
		"@types/node": "^22.10.0",
		"@types/pg": "^8.11.0",
		"@types/ws": "^8.5.0",
		"drizzle-kit": "0.31.10",
		"pino-pretty": "^13.0.0",
		"tsx": "^4.19.0",
		"typescript": "^5.9.0",
		"vitest": "^3.2.0"
	}
}
