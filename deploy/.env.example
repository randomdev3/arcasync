# Public hostname (Caddy will obtain a TLS cert for it)
DOMAIN=sync.example.com
ARCASYNC_PUBLIC_URL=https://sync.example.com

# Generate with: openssl rand -hex 32
ARCASYNC_SECRET=change-me
# One-time token used to create the first admin via POST /api/auth/bootstrap
ARCASYNC_ADMIN_BOOTSTRAP_TOKEN=change-me-too

POSTGRES_PASSWORD=change-me
MINIO_ROOT_USER=teamsync
MINIO_ROOT_PASSWORD=change-me

LOG_LEVEL=info
LOG_FORMAT=json
# Never enable in production:
ARCASYNC_DEV_OPEN_LOGIN=0
