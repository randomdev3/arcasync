{
	"name": "teamsync-monorepo",
	"private": true,
	"packageManager": "pnpm@11.10.0",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "turbo run dev --filter=@teamsync/relay-cf --filter=@teamsync/plugin",
		"dev:node": "turbo run dev --filter=@teamsync/server --filter=@teamsync/plugin",
		"build": "turbo run build",
		"test": "turbo run test",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"typecheck": "turbo run typecheck",
		"db:generate": "pnpm --filter @teamsync/server db:generate",
		"e2e:p0": "node scripts/e2e/p0-counter.mjs",
		"e2e:p1": "node scripts/e2e/run.mjs --suite p1",
		"e2e:smoke": "node scripts/e2e/smoke-harness.mjs"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.2.0",
		"@types/pngjs": "^6.0.5",
		"pngjs": "^7.0.0",
		"turbo": "^2.5.0",
		"typescript": "^5.9.0"
	}
}
