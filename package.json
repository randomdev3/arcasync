{
	"name": "teamsync-monorepo",
	"private": true,
	"packageManager": "pnpm@11.10.0",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"test": "turbo run test",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"typecheck": "turbo run typecheck",
		"db:generate": "pnpm --filter @teamsync/server db:generate"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.2.0",
		"turbo": "^2.5.0",
		"typescript": "^5.9.0"
	}
}
